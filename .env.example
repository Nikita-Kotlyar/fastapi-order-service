# Copy to .env. Never commit real secrets.
ORDERHUB_ENVIRONMENT=production
POSTGRES_PASSWORD=replace-with-strong-password
# SQLite для быстрого старта; Docker Compose подставляет PostgreSQL.
ORDERHUB_DATABASE_URL=sqlite:///./orderhub.db
ORDERHUB_REDIS_URL=
ORDERHUB_JWT_SECRET=replace-with-32-byte-secret
ORDERHUB_ADMIN_USERNAME=admin
ORDERHUB_ADMIN_PASSWORD=replace-with-strong-password
ORDERHUB_ANALYST_USERNAME=analyst
ORDERHUB_ANALYST_PASSWORD=replace-with-strong-password
ORDERHUB_VIEWER_USERNAME=viewer
ORDERHUB_VIEWER_PASSWORD=replace-with-strong-password
ORDERHUB_SEED_DEFAULT_USERS=true
ORDERHUB_SOURCE_DIR=data/reference
ORDERHUB_AUTO_CREATE_TABLES=false
ORDERHUB_CACHE_TTL_SECONDS=60
ORDERHUB_LOG_LEVEL=INFO
